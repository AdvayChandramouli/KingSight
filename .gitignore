# Source CSVs are tracked. Ignore anything else dropped under data/.
data/*
!data/kc_house_data.csv
!data/kc_cleaned_data.csv

# Catalog SQLite is generated by scripts/export_catalog.py. Do not commit it.
artifacts/catalog/*.sqlite
artifacts/catalog/*.sqlite-journal
artifacts/catalog/*.sqlite-wal
artifacts/catalog/*.sqlite-shm

.cursor
.venv
.ruff_cache
.pytest_cache/
catboost_info
__pycache__/
*.py[cod]

# Markdown is local agent context. Only the repository README is versioned.
# Relief deliverables are the exception: the design system, the photo ledger, and the geometry note.
*.md
!/README.md
!/DESIGN.md
!/docs/design/photography-ledger.md
!/docs/design/relief-geometry.md