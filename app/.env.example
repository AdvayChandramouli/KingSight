# KingSight frontend configuration. Copy to `.env.local` and adjust.
# Everything here is client-visible at build time — never put secrets in it.

# Data source: `mock` (deterministic illustrative fixtures, no backend) or `api`.
# API mode never falls back to mocks; a missing base URL shows a config error.
VITE_DATA_MODE=mock

# Required when VITE_DATA_MODE=api. Example: https://api.example.com/v1
VITE_API_BASE_URL=

# MapLibre style URL. Leave empty to use the offline schematic map fallback
# (works without credentials). Check the tile provider's terms before using
# any public demo style in production. Example for local evaluation:
#   VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL=

# Attribution text required by your tile/style provider (shown on the map).
#   VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors · OpenFreeMap
VITE_MAP_ATTRIBUTION=

# Developer scenario controls (mock mode only). Always on in `npm run dev`;
# set to true to include them in a production build for QA.
VITE_ENABLE_SCENARIOS=false

# Per-request timeout for API mode (milliseconds).
VITE_REQUEST_TIMEOUT_MS=15000
