# KingSight configuration. Copy to `app/.env.local` for the frontend.
# VITE_* values are client-visible at build time — never put secrets in them.

# Data source: `mock` (deterministic illustrative fixtures, no backend) or `api`.
# API mode never falls back to mocks; a missing base URL shows a config error.
VITE_DATA_MODE=mock

# Required when VITE_DATA_MODE=api. Example: https://api.example.com/v1
VITE_API_BASE_URL=

# Optional MapLibre style override. Unset or empty uses OpenFreeMap Positron
# (OSM data, free, no API key):
#   https://tiles.openfreemap.org/styles/positron
# Do not point this at tile.openstreetmap.org. No paid tile keys.
VITE_MAP_STYLE_URL=

# Optional attribution override shown in the compact MapLibre control.
# Unset or empty uses: © OpenStreetMap contributors · OpenFreeMap
VITE_MAP_ATTRIBUTION=

# Developer scenario controls (mock mode only). Always on in `npm run dev`;
# set to true to include them in a production build for QA.
VITE_ENABLE_SCENARIOS=false

# Per-request timeout for API mode (milliseconds).
VITE_REQUEST_TIMEOUT_MS=15000

# API process environment (the uvicorn shell — Vite does not read these).
# Empty or unset uses the default path, origin list, or log level.
# KINGSIGHT_ARTIFACT_DIR=          # default: artifacts/ (xgboost, gnn, scaler)
# KINGSIGHT_CATALOG_PATH=          # default: artifacts/catalog/properties.sqlite
# KINGSIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# KINGSIGHT_LOG_LEVEL=INFO
